/build/
/tarballs/
# direnv's cache for the dev shell.
/.direnv/
# Produced bundles, when copied out of the store by hand.
*.kernel
# Local Python noise.
__pycache__/
*.pyc
/venv/
# Editor and OS noise.
/.idea/
.DS_Store
